@page
@using API.Controllers
@using APPCORE.Security
@using DataBaseModel
@{
    string? identify = HttpContext?.Session.GetString("sessionKey");
    PageConfig? pageConfig = Config.pageConfig();
    if (!SecurityController.HavePermission(identify, Permissions.REPORTE_ACCESS))
    {
        Response.Redirect("/");
        return;
    }
}
<script type="module">
    import {ReporteActualizacionesView} from "/Reportes/ReporteActualizacionesView.mjs";
    window.onload = ()=> {
        Main.append(new ReporteActualizacionesView({initialize: true}));
    } 
</script>
<div id="Main"></div>